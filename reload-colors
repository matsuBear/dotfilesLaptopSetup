#!/usr/bin/env bash

SOURCE="$HOME/.config/aesth/color.conf"

if [ ! -f "$SOURCE" ]; then
	echo "Please create a color.conf file ;)"
	exit 1
fi

source "$SOURCE"

# Old name -> new name (output keys below are unchanged so existing configs keep working)
#   prim  -> primCold      secd  -> secdCold     acct  -> midWarm
#   tone1 -> lightWarm     tone2 -> darkCold

cat <<EOF > "$HOME/.config/kitty/aesth.conf"

background #${darkCold}
foreground #${lightWarm}

EOF





cat <<EOF > "$HOME/.config/waybar/color.css"

@define-color prim #${primCold};

@define-color secd #${secdCold};

@define-color acct #${midWarm};
@define-color high-tone #${lightWarm};
@define-color low-tone #${darkCold};

@define-color mid-light-cold #${midLightCold};
@define-color mid-dark-cold #${midDarkCold};
@define-color prim-warm #${primWarm};
@define-color secd-warm #${secdWarm};
@define-color green #${greenAlt};
@define-color red #${redAlt};
@define-color blue #${blueAlt};
@define-color pink #${pinkAlt};

EOF

cat <<EOF > "$HOME/.config/wofi/color.css"

@define-color prim #${primCold};

@define-color secd #${secdCold};

@define-color acct #${midWarm};
@define-color high-tone #${lightWarm};
@define-color low-tone #${darkCold};

@define-color mid-light-cold #${midLightCold};
@define-color mid-dark-cold #${midDarkCold};
@define-color prim-warm #${primWarm};
@define-color secd-warm #${secdWarm};
@define-color green #${greenAlt};
@define-color red #${redAlt};
@define-color blue #${blueAlt};
@define-color pink #${pinkAlt};

EOF

cat <<EOF > "$HOME/.config/hypr/color.lua"

return {
	prim="rgba(${primCold}ff)",
	secd="rgba(${secdCold}ff)",
	acct="rgba(${midWarm}ff)",
	high_tone="rgba(${lightWarm}ff)",
	low_tone="rgba(${darkCold}ff)",

	mid_light_cold="rgba(${midLightCold}ff)",
	mid_dark_cold="rgba(${midDarkCold}ff)",
	prim_warm="rgba(${primWarm}ff)",
	secd_warm="rgba(${secdWarm}ff)",
	green="rgba(${greenAlt}ff)",
	red="rgba(${redAlt}ff)",
	blue="rgba(${blueAlt}ff)",
	pink="rgba(${pinkAlt}ff)"

}

EOF

cat <<EOF > "$HOME/.config/nvim/lua/custom/colors.lua"
return {
  prim           = "#${primCold}",
  secd           = "#${secdCold}",
  acct           = "#${midWarm}",
  high_tone      = "#${lightWarm}",
  low_tone       = "#${darkCold}",

  mid_light_cold = "#${midLightCold}",
  mid_dark_cold  = "#${midDarkCold}",
  prim_warm      = "#${primWarm}",
  secd_warm      = "#${secdWarm}",
  green          = "#${greenAlt}",
  red            = "#${redAlt}",
  blue           = "#${blueAlt}",
  pink           = "#${pinkAlt}",
}
EOF


hexToRGB(){
	local COLOR=$1
	local R=$(printf "%d" "0x${COLOR:0:2}")
	local G=$(printf "%d" "0x${COLOR:2:2}")
	local B=$(printf "%d" "0x${COLOR:4:2}")
	echo "$R;$G;$B"
}


vlight=$(hexToRGB ${lightWarm})
vdark=$(hexToRGB ${primCold})

cat<<EOF > "$HOME/.config/bash/color.sh"

light=$'\001\033[38;2;'"${vlight}"$'m\002'
light_bold=$'\001\033[1;38;2;'"${vlight}"$'m\002'
dark=$'\001\033[38;2;'"${vdark}"$'m\002'
dark_bold=$'\001\033[1;38;2;'"${vdark}"$'m\002'

EOF

cat<<EOF > "$HOME/.config/qutebrowser/colors.py"

prim="#${primCold}"
secd="#${secdCold}"
acct="#${midWarm}"
low_tone="#${darkCold}"
high_tone="#${lightWarm}"

mid_light_cold="#${midLightCold}"
mid_dark_cold="#${midDarkCold}"
prim_warm="#${primWarm}"
secd_warm="#${secdWarm}"
green="#${greenAlt}"
red="#${redAlt}"
blue="#${blueAlt}"
pink="#${pinkAlt}"

EOF

cat<<'EOF' > "$HOME/.config/bash/prompt.sh" 

source "$HOME/.config/bash/color.sh"

shopt -s promptvars
PS1=$'\n '"${dark_bold}"' \u '"${light}"' [\W]'"${light_bold}${reset}"$'\n     > '
EOF


echo -e "Palette compiled!"


